{
  "name": "@traxettle/mobile",
  "version": "1.1.0",
  "description": "Traxettle mobile app — iOS & Android",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "start:tunnel": "expo start --tunnel",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache .expo",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios:safe": "bash ../../tools/doctor-tool/scripts/safe-prebuild.sh ios",
    "prebuild:android:safe": "bash ../../tools/doctor-tool/scripts/safe-prebuild.sh android",
    "build:android": "bash scripts/build-android.sh production",
    "build:android:debug": "bash scripts/build-android.sh debug",
    "build:android:debug:staging": "bash scripts/build-android.sh debug:staging",
    "build:android:production": "bash scripts/build-android.sh production",
    "build:ios:debug": "bash scripts/build-ios.sh debug",
    "build:ios:testflight": "bash scripts/build-ios.sh testflight",
    "build:ios:xcode": "bash scripts/build-ios.sh xcode",
    "build:ios:xcode-done": "bash scripts/build-ios.sh xcode-done",
    "version:show": "bash scripts/version.sh status",
    "version:bump": "bash scripts/version.sh bump",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:maestro": "RUN_ID=${RUN_ID:-$(date +%s)} sh maestro/scripts/run-maestro.sh normal",
    "test:maestro:artifacts": "RUN_ID=${RUN_ID:-$(date +%s)} sh maestro/scripts/run-maestro.sh artifacts",
    "test:maestro:android": "RUN_ID=${RUN_ID:-$(date +%s)} MAESTRO_DEVICE=${MAESTRO_DEVICE:-emulator-5556} sh maestro/scripts/run-maestro.sh normal",
    "test:maestro:ios": "RUN_ID=${RUN_ID:-$(date +%s)} sh maestro/scripts/run-maestro.sh normal",
    "rush:dev:api": "cd ../.. && rush dev:api",
    "rush:dev:mobile": "cd ../.. && rush dev:mobile",
    "rush:test:mobile": "cd ../.. && rush test:mobile",
    "rush:test:mobile:coverage": "cd ../.. && rush test:mobile:coverage",
    "rush:test:e2e": "cd ../.. && rush test:e2e",
    "rush:test:maestro": "cd ../.. && rush test:maestro",
    "rush:test:maestro:artifacts": "cd ../.. && rush test:maestro:artifacts",
    "rush:qa:all": "cd ../.. && rush test:mobile:coverage && rush test:e2e && rush test:maestro"
  },
  "keywords": [
    "traxettle",
    "mobile",
    "react-native",
    "expo"
  ],
  "author": "Traxettle Team",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native/community-cli-plugin": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@traxettle/shared": "workspace:^1.0.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-local-authentication": "~58.0.3",
    "expo-modules-core": "~58.1.0",
    "expo-print": "~58.0.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^11.0.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "socket.io-client": "^4.7.0",
    "styled-components": "^6.1.0",
    "expo-intent-launcher": "~58.0.3",
    "firebase": "~12.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.22",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.1.2",
    "@types/styled-components-react-native": "^5.2.0",
    "typescript": "^5.0.0",
    "babel-preset-expo": "~58.0.26"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "typescript"
      ]
    }
  }
}
